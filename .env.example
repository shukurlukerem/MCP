# ─── Runtime ─────────────────────────────────────────────────────────────────
ENVIRONMENT=development            # development | staging | production
LOG_LEVEL=INFO
# Public origin of THIS service (must be https in production). This is the host
# the frontend and Google talk to — e.g. https://mcp-dev.sabahos.com in dev.
PUBLIC_BASE_URL=http://localhost:8000
# Set only when served under a path prefix by a reverse proxy, e.g. /mcp
ROOT_PATH=

# ─── Database ────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://user:password@postgres:5432/mcpdb
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=mcpdb
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# ─── Redis ───────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ─── Security ────────────────────────────────────────────────────────────────
# JWT signing key — openssl rand -hex 32
SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32
# Token encryption key — python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=change-me-use-cryptography-Fernet-generate-key
# Shared secret with SABAH.OS Django (identical value in both .env files). Used
# BOTH ways: Django → this service, and this service → Django when it delegates
# the SABAH.OS session after a Google sign-in. Must equal Django's
# MCP_INTERNAL_API_KEY.
# python -c "from app.core.config import generate_internal_key as g; print(g())"
INTERNAL_API_KEY=change-me-shared-with-sabah-os-django

# ─── SABAH.OS (Django) API ────────────────────────────────────────────────────
# This service owns Google OAuth but delegates the SABAH.OS session to Django:
# after verifying the Google identity it POSTs the claims to
# {SABAH_API_BASE_URL}/api/v1/auth/google/internal/complete/.
SABAH_API_BASE_URL=https://api.sabahos.com

# ─── Google OAuth (https://console.cloud.google.com) ─────────────────────────
# The Google client lives HERE (MCP owns the OAuth flow). Add this service's
# callback as an Authorized redirect URI in the Google Console:
#   https://mcp-dev.sabahos.com/auth/google/callback
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
GOOGLE_REDIRECT_URI=https://mcp-dev.sabahos.com/auth/google/callback
# Corporate gate — only these Workspace domains may connect. Required in production.
ALLOWED_EMAIL_DOMAINS=["sabahhub.com","devers.tech","integritygroup.az"]
# Pre-filters Google's account chooser to one domain (optional)
GOOGLE_HOSTED_DOMAIN=sabahhub.com
# Services requested on the consent screen when GOOGLE_OAUTH_SCOPE_TIER=full.
# Optional (admin-only, off by default): admin_directory, admin_reports
GOOGLE_SERVICES=["gmail","drive","calendar","docs","sheets","slides","contacts","tasks","forms","chat","meet"]

# ─── Google verification posture ─────────────────────────────────────────────
# Which scopes the authorization request asks for:
#   login_only — openid/email/profile only. All three are non-sensitive, so Google
#                shows no "unverified app" screen and the request does not draw on
#                the project's lifetime 100-user cap. KEEP THIS until Google has
#                approved the app.
#   full       — identity + every Workspace scope (sensitive). Only safe after
#                verification completes; flipping it early re-exposes the
#                unverified-app screen and the exhausted user cap.
GOOGLE_OAUTH_SCOPE_TIER=login_only

# Master switch for every Google Workspace API call. False = fail closed with a
# user-facing message. Stored tokens are untouched either way, so turning this back
# on restores service without asking employees to re-consent.
GOOGLE_WORKSPACE_INTEGRATIONS_ENABLED=false

# Narrow exemption: minting a Google Meet link for an event the user just created.
# User-initiated, writes only to the organiser's own calendar, and `calendar` is
# sensitive rather than restricted — so it stays available to grants that already
# carry Calendar access while the broad read surface is paused.
GOOGLE_CALENDAR_CONFERENCE_ENABLED=true

# Reading the signed-in employee's own calendar, so SABAH.OS can mirror it into
# its calendar page once an hour. Same scope and same reasoning as the exemption
# above, but a separate switch: stopping the unattended hourly pull should not
# also break the Meet button someone is pressing right now.
#
# This switch also governs incremental sync (`POST /internal/google/calendar/
# events/sync`), where the run sends Google a syncToken and gets back only what
# has changed. Nothing else is needed to enable it — no extra credential, no
# extra scope, and no new dependency; the token is stored by SABAH.OS against
# the member's sync row. Turning the switch off simply stops both.
GOOGLE_CALENDAR_SYNC_ENABLED=true

# ─── SABAH.OS ────────────────────────────────────────────────────────────────
# Where the OAuth callback sends the browser after sign-in — the SPA callback page.
FRONTEND_REDIRECT_URL=https://sabahos.com/auth/google/callback

# ─── LLM (optional) ──────────────────────────────────────────────────────────
# Only POST /automation/run needs this. Leave it empty and that one endpoint
# returns 503 — Google OAuth, the direct /google endpoints and the MCP server
# this app exposes all keep working. Enabling it also requires the optional
# package: pip install "openai>=1.68.0,<2.0.0"
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1
LLM_MAX_OUTPUT_TOKENS=4096

# ─── CORS (JSON list — never "*" with credentials) ───────────────────────────
# Must include the frontend origin — the SPA fetches /auth/google/url from here.
ALLOWED_ORIGINS=["https://sabahos.com","http://localhost:3000"]

# ─── JWT ─────────────────────────────────────────────────────────────────────
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
OAUTH_STATE_TTL_SECONDS=600
