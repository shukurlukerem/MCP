# Database
DATABASE_URL=postgresql+asyncpg://user:password@postgres:5432/mcpdb
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=mcpdb

# Redis
REDIS_URL=redis://redis:6379/0

# Security — generate with: openssl rand -hex 32
SECRET_KEY=change-me-in-production-use-openssl-rand-hex-32

# Fernet key — generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=change-me-use-cryptography-Fernet-generate-key

# Google OAuth (https://console.cloud.google.com)
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback

# OpenAI
OPENAI_API_KEY=sk-your-openai-key-here
OPENAI_MODEL=gpt-4.1

# CORS origins (JSON list)
ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:8000"]

# JWT
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
